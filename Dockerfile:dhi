# syntax=docker/dockerfile:1

# =============================================================================
# Grinning Cat Core — Hardened image (Docker Hardened Images variant)
#
# Hardening applied in this file:
#   1. MULTI-STAGE: compilers & dev-tooling (gcc/make/libc6-dev/build-essential)
#      live ONLY in the builder stage. The runtime image contains none of them
#      in ANY layer (vs. the old purge approach, where they remained recoverable
#      from intermediate layers and bloated the image).
#   2. Base images pinned by digest for supply-chain integrity.
#   3. Runs as an unprivileged user (uid 10001) — never as root.
#   4. PYTHONDONTWRITEBYTECODE=1 — no bytecode written at runtime.
#   5. Explicit STOPSIGNAL + HEALTHCHECK.
#   6. NLTK data moved to an explicit, owned path so it survives the non-root
#      switch (the old default ~/nltk_data would have landed in /root).
# =============================================================================

# Build-time proxy only — consumed during image construction, never baked in.
ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY

# ---------------------------------------------------------------------------
# Stage 1 — BUILDER
# ---------------------------------------------------------------------------
# `-dev` variant on purpose: it ships the compilers/headers required to build
# native extensions (pydantic-core, spaCy, numpy, python-magic, ...).
FROM dhi.io/python:3.13-dev@sha256:81978c0c24990a7a88a061625697df4078afa92d9967ec42fae7d2e9a078371f AS builder

ENV PYTHONUNBUFFERED=1 \
    UV_NO_CACHE=1 \
    UV_LINK_MODE=copy \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/app/.venv/bin:$PATH" \
    VIRTUAL_ENV=/app/.venv

# uv — fast deterministic installs (copied again into the runtime stage)
COPY --from=dhi.io/uv:0 /usr/local/bin/uv /usr/local/bin/uvx /usr/local/bin/

WORKDIR /app

# Build-only system dependencies (compilers + dev headers stay in this stage)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        libmagic1 \
        libmagic-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Manifests first, to leverage layer caching (rebuilt only when deps change)
COPY pyproject.toml uv.lock ./
COPY ./cat/core_plugins ./cat/core_plugins
COPY ./scripts/hash_plugin_requirements.py ./scripts/hash_plugin_requirements.py

# Deterministic single-pass install of core + all plugin extras
RUN uv venv --seed .venv && \
    uv sync --frozen --no-install-project --no-dev --extra plugins && \
    python3 scripts/hash_plugin_requirements.py

# Pre-download spaCy models and NLTK data at build time (no runtime downloads).
# NLTK data is pinned to /app/nltk_data so it stays valid for the non-root user.
RUN spacy download it_core_news_lg && \
    spacy download en_core_web_lg && \
    spacy download en_core_web_sm && \
    python -m nltk.downloader -d /app/nltk_data punkt averaged_perceptron_tagger

# Remove build-time caches
RUN rm -rf /root/.cache /tmp/* /var/tmp/*

# ---------------------------------------------------------------------------
# Stage 2 — RUNTIME (final)
# ---------------------------------------------------------------------------
# Non-dev image: no compilers, no dev headers, no build toolchain.
FROM dhi.io/python:3.13@sha256:e512071462b6f002ac3d6f4d31bdf7d20fe6ffce3b5ce4f684b5e50d14dba217 AS final

ENV PYTHONUNBUFFERED=1 \
    UV_NO_CACHE=1 \
    UV_LINK_MODE=copy \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/app/.venv/bin:$PATH" \
    VIRTUAL_ENV=/app/.venv \
    NLTK_DATA=/app/nltk_data \
    PORT=80

# Runtime-only system dependencies (no compilers, no dev headers).
# Note: `libreoffice*nogui` / `tesseract-ocr-{ita,eng}` kept verbatim from the
# previous single-stage image to preserve behavior.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        curl \
        libmagic1 \
        poppler-utils \
        tesseract-ocr \
        libgl1 \
        media-types \
        mailcap \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Required by unstructured[all-docs] in the grinning-cat-plus plugin
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        libreoffice*nogui \
        pandoc \
        ffmpeg \
        tesseract-ocr-{ita,eng} \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# uv runtime binary — needed for on-demand plugin dependency installs
COPY --from=dhi.io/uv:0 /usr/local/bin/uv /usr/local/bin/uvx /usr/local/bin/

# Unprivileged runtime user
RUN groupadd --gid 10001 cat \
    && useradd --uid 10001 --gid cat --create-home --shell /usr/sbin/nologin cat

WORKDIR /app

# Application, virtualenv, spaCy models and NLTK data — owned by the runtime user
COPY --from=builder --chown=cat:cat /app /app

# Fresh source + migrations + license + entrypoint
COPY --chown=cat:cat ./cat ./cat
COPY --chown=cat:cat ./migrations ./migrations
COPY --chown=cat:cat ./LICENSE ./
COPY --chown=cat:cat ./docker/entrypoint.sh ./docker/entrypoint.sh
RUN chmod +x ./docker/entrypoint.sh

# Drop privileges for the runtime process and everything it spawns
USER cat

EXPOSE 80

STOPSIGNAL SIGTERM

HEALTHCHECK --interval=30s --timeout=5s --start-period=45s --retries=3 \
    CMD ["python", "-c", "import urllib.request, sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:80/health/liveness', timeout=3).status == 200 else 1)"]

ENTRYPOINT ["./docker/entrypoint.sh"]
CMD ["python", "-m", "cat.main"]
